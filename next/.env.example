# Copy this file to .env.local and change values.
#   cp .env.example .env.local

# Origin of the backend API (the FastAPI app in ../fastapi).
# Do not put a slash at the end.
# The Next.js server uses it in two places:
#   - next.config.ts forwards /api/* to this origin
#   - Server Components fetch from it directly (lib/api.ts)
API_URL=http://127.0.0.1:8000
