{erl_opts, [debug_info, warnings_as_errors, warn_export_all, warn_unused_import]}.
{deps, []}.

{project_plugins, [{erlfmt, "1.8.0"}]}.

{escript_name, word_count}.
{escript_main_app, word_count}.
{escript_main_module, word_count_cli}.

{dialyzer, [{warnings, [unmatched_returns, error_handling, underspecs]}]}.
{xref_checks, [undefined_function_calls, undefined_functions, deprecated_function_calls]}.

{alias, [
    {check, [compile, {fmt, "--check"}, eunit, xref, dialyzer]}
]}.
