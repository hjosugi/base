{
  "version": "0.2.0",
  "configurations": [
    {
      // F5: run the command line tool under the debugger.
      // Change "args" to try other input.
      "name": "wordcount: run (README.md)",
      "type": "debugpy",
      "request": "launch",
      "module": "wordcount_cli.cli",
      "args": ["README.md", "-n", "5"],
      "justMyCode": true
    },
    {
      // Run the file that is open now.
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      // Debug the test file that is open now.
      // --no-cov: coverage and the debugger can get in each other's way.
      "name": "pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-x", "-vv", "--no-cov"],
      "justMyCode": false
    },
    {
      // Attach to a program started in a terminal with:
      //   uv run python -m debugpy --listen 5678 --wait-for-client -m wordcount_cli.cli README.md
      "name": "Attach to debugpy (:5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "127.0.0.1", "port": 5678 },
      "justMyCode": true
    }
  ]
}
