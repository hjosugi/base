{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rust: wordcount README.md",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin", "wordcount"],
        "filter": { "name": "wordcount", "kind": "bin" }
      },
      "args": ["README.md", "-n", "5"],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    }
  ]
}
